{
  "name": "schemas-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Static preview for Schemas Directory UI (development tooling only)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "http-server ui/public -p 5173 -c -1",
    "start": "npm run dev",
    "dev:5174": "http-server ui/public -p 5174 -c -1",
    "dev:app": "vite --config ui/vite.config.ts",
    "build:app": "vite build --config ui/vite.config.ts",
    "preview:app": "vite preview --config ui/vite.config.ts --port 4173",
  "generate:index": "ts-node -P tsconfig.json ui/scripts/generate-schemas-index.ts",
    "build:schemas": "npm run generate:index",
    "dev:all": "npm run build:schemas && npm run dev"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "ajv-formats": "2.1.1",
    "ajv": "8.12.0",
    "http-server": "14.1.1",
    "vite": "5.4.8",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
