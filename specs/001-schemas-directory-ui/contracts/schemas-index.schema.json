{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schemas-ui/schemas-index.schema.json",
  "title": "Schemas Index",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "generatedAt": { "type": "string", "format": "date-time" },
    "root": { "$ref": "#/definitions/DirectoryNode" }
  },
  "required": ["generatedAt", "root"],
  "definitions": {
    "DirectoryNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "enum": ["folder", "schema"] },
        "path": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/DirectoryNode" }
        }
      },
      "required": ["name", "type", "path"],
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "schema" } }, "required": ["type"] },
          "then": { "not": { "required": ["children"] } }
        }
      ]
    }
  }
}
